        <mxCell id="cnt1_tech" value="[Container: เว็บแอปในเบราว์เซอร์ Responsive · React]" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#087E8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120.0" y="338.0" width="600.0" height="25.0" as="geometry"/></mxCell>
        <mxCell id="cnt1_desc" value="หน้าค้นหารายการของที่พบ · ฟอร์มแจ้งเบาะแส · ฟอร์มแจ้งของหาย · ยื่นหลักฐาน · คิวตรวจคำร้องและจัดการคลังของ Staff&lt;br&gt;แสดงเมนูตาม role (RBAC) · ออกแบบเป็น Responsive Web (NFR-CLF-02) — ไม่เก็บข้อมูลถาวร ไม่ใช่ที่ตัดสินสิทธิ์จริง (DEC-01)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#172333;" vertex="1" parent="1"><mxGeometry x="120.0" y="368.0" width="750.0" height="45.0" as="geometry"/></mxCell>
        <mxCell id="cnt1_badge" value="หน้าจอออกแบบใน W12" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#008699;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#087E8B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710.0" y="410.0" width="170.0" height="28.0" as="geometry"/></mxCell>

